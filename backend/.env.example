# RepoGenie Backend Configuration
APP_NAME=RepoGenie API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS settings (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=./storage
REPOS_DIR=./storage/repos

# Repository Ingestion Configuration
CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=500
CLONE_DEPTH=1

# Repository Structure & Analysis Limits (Milestone 2.3)
MAX_TRAVERSAL_DEPTH=15
MAX_FILES_INDEXED=5000
MAX_FILE_SIZE_BYTES=1048576

# Code Parsing & Structural Extraction Limits (Milestone 2.4)
MAX_CODE_FILE_SIZE_BYTES=524288
MAX_CODE_FILES_TO_PARSE=500
MAX_SNIPPET_LINES=60
MAX_SNIPPET_CHARS=2500

# Architecture & Dependency Analysis Limits (Milestone 2.5)
MAX_GRAPH_NODES=1000
MAX_GRAPH_EDGES=5000
MAX_RELATIONSHIPS_PER_FILE=100
MAX_UNRESOLVED_REFS_RETAINED=500

# Unified Repository Knowledge Limits (Milestone 2.6)
MAX_IMPORTANT_FILES=50
MAX_SOURCE_EVIDENCE_RECORDS=500

# AI Integration Foundation (Milestone 3.1)
AI_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# Future Milestone Configurations (Prepared for Milestones 4-6)
# GITHUB_TOKEN=

# ElevenLabs Narration Configuration (Milestone 5.4)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT=30.0
ELEVENLABS_MAX_RETRIES=3

# FFmpeg & Video Assembly Configuration (Milestone 6.1)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_RENDER_TIMEOUT=300
VIDEO_OUTPUT_DIR=./storage/jobs
VIDEO_DEFAULT_FPS=30
VIDEO_DEFAULT_CODEC=libx264
VIDEO_DEFAULT_AUDIO_CODEC=aac
VIDEO_DEFAULT_WIDTH=1920
VIDEO_DEFAULT_HEIGHT=1080
VIDEO_DEFAULT_PIX_FMT=yuv420p
