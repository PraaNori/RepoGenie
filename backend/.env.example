# RepoGenie Backend Configuration
APP_NAME=RepoGenie API
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS settings (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=./storage
REPOS_DIR=./storage/repos

# Repository Ingestion Configuration
CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=500
CLONE_DEPTH=1

# Repository Structure & Analysis Limits (Milestone 2.3)
MAX_TRAVERSAL_DEPTH=15
MAX_FILES_INDEXED=5000
MAX_FILE_SIZE_BYTES=1048576

# Code Parsing & Structural Extraction Limits (Milestone 2.4)
MAX_CODE_FILE_SIZE_BYTES=524288
MAX_CODE_FILES_TO_PARSE=500
MAX_SNIPPET_LINES=60
MAX_SNIPPET_CHARS=2500

# Architecture & Dependency Analysis Limits (Milestone 2.5)
MAX_GRAPH_NODES=1000
MAX_GRAPH_EDGES=5000
MAX_RELATIONSHIPS_PER_FILE=100
MAX_UNRESOLVED_REFS_RETAINED=500

# Unified Repository Knowledge Limits (Milestone 2.6)
MAX_IMPORTANT_FILES=50
MAX_SOURCE_EVIDENCE_RECORDS=500

# Future Milestone Configurations (Prepared for Milestones 3-6)
# GITHUB_TOKEN=
# OPENAI_API_KEY=
# TTS_PROVIDER=local
